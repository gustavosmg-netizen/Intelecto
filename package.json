{
  "name": "portal-intelecto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:check": "wrangler deploy --dry-run --outdir dist-check",
    "build:app": "npm --prefix app ci && npm --prefix app run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "npm run build:app && npm run build:check && npm test",
    "db:schema": "wrangler d1 execute portal-intelecto --remote --file=./schema.sql",
    "db:migrate:staging": "wrangler d1 migrations apply portal-intelecto-staging --remote",
    "db:migrate:local": "wrangler d1 migrations apply portal-intelecto --local",
    "consistency:staging": "wrangler d1 execute portal-intelecto-staging --remote --file=consistency/rules.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^5.20250101.0"
  }
}
